# Dashboard. En local, si no pones nada, la clave es: nfctab
DASHBOARD_PASSWORD=cambia-esto
DASHBOARD_SECRET=una-cadena-larga-aleatoria

# Polar (producción). Bizum sale solo si el comprador está en España: la API
# reenvía su IP. Cuatro productos one-time (no un cupón de 2×1):
# genérica 20 / pack 35 · personalizada 30 / pack 55.
# 3 o más usan el producto pack (_2) con el importe a medida (primera + extra).
# Google, WhatsApp e Instagram usan los dos GENERIC_*. No hace falta un producto Polar por modelo.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production
POLAR_PRODUCT_GENERIC_1=
POLAR_PRODUCT_GENERIC_2=
POLAR_PRODUCT_CUSTOM_1=
POLAR_PRODUCT_CUSTOM_2=

NEXT_PUBLIC_SITE_URL=https://nfctap.tech

# Pixel de Meta Ads (dataset NFCTap.Tech). Sin esto se usa el ID de producción.
NEXT_PUBLIC_META_PIXEL_ID=2498883970623744
# Events Manager → conjunto NFCTap.Tech → Ajustes → generar token.
META_CAPI_ACCESS_TOKEN=
# Solo pruebas. Si está puesto, las compras salen en «Probar eventos» y no cuentan para anuncios.
META_CAPI_TEST_EVENT_CODE=

# Opcional. Places API (Text Search) para buscar por nombre.
# Sin esto, pega el enlace de Google Maps o del perfil de empresa: la web
# lo convierte al de reseña (writereview / g.page).
GOOGLE_PLACES_API_KEY=

# Pedidos persistentes en Vercel (Storage → Blob → token)
BLOB_READ_WRITE_TOKEN=
