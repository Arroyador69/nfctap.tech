# Dashboard. En local, si no pones nada, la clave es: nfctab
DASHBOARD_PASSWORD=cambia-esto
DASHBOARD_SECRET=una-cadena-larga-aleatoria

# Stripe (prioridad sobre Polar si STRIPE_SECRET_KEY está). Test: sk_test_ / pk_test_
# Docs: web/STRIPE_INTEGRATION_TODO.md · npm run stripe:setup
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcionales (catálogo Dashboard; el checkout usa price_data):
# STRIPE_PRICE_GENERIC_1= STRIPE_PRICE_GENERIC_2= STRIPE_PRICE_CUSTOM_1=
# STRIPE_PRICE_CUSTOM_2= STRIPE_PRICE_WIFI_1= STRIPE_PRICE_UNICA_1=

# Polar (fallback). Bizum si el comprador está en España.
# genérica 20 / pack 35 · personalizada 30 / pack 55 · TAP Wi‑Fi 15 · única 80.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production
POLAR_PRODUCT_GENERIC_1=
POLAR_PRODUCT_GENERIC_2=
POLAR_PRODUCT_CUSTOM_1=
POLAR_PRODUCT_CUSTOM_2=
POLAR_PRODUCT_WIFI_1=

NEXT_PUBLIC_SITE_URL=https://nfctap.tech

# Pixel de Meta Ads (dataset NFCTap.Tech). Sin esto se usa el ID de producción.
NEXT_PUBLIC_META_PIXEL_ID=2498883970623744
# Events Manager → conjunto NFCTap.Tech → Ajustes → generar token.
META_CAPI_ACCESS_TOKEN=
# Solo pruebas. Si está puesto, las compras salen en «Probar eventos» y no cuentan para anuncios.
META_CAPI_TEST_EVENT_CODE=

# Opcional. Places API (Text Search) para buscar por nombre.
# Sin esto, pega el enlace de Google Maps o del perfil de empresa: la web
# lo convierte al de reseña (writereview / g.page).
GOOGLE_PLACES_API_KEY=

# Pedidos y lista nevera: mismo Blob de Vercel (Storage → Blob → token).
# NO hace falta Neon ni SQL. Si falta el token, en Vercel la lista se pierde al recargar.
BLOB_READ_WRITE_TOKEN=

# Lista nevera: opcional. Si no está, se usa DASHBOARD_PASSWORD.
# Activar una vez desde la Wi‑Fi de casa:
#   https://nfctap.tech/lista/casa?activar=ESA_CLAVE
LISTA_HOME_SECRET=

# Opcional. Search Console (también se puede pegar desde /dashboard/visitas).
GOOGLE_SITE_VERIFICATION=

# Opcional. Borradores de guía desde /dashboard/seo (solo admin). No publica solo.
OPENAI_API_KEY=

# Outreach negocios locales (cold email). Dominio nfctap.tech verificado en Resend.
# Docs: web/docs/OUTREACH_NFCTAP.md · ritmo 500/día · meta ≥5 ventas /negocio
RESEND_API_KEY=
RESEND_FROM=NFCTap <hola@nfctap.tech>

# Polar · producto /negocio (logo + 1–3 chips). npm run polar:setup
POLAR_PRODUCT_UNICA_1=

# Telegram · confirmaciones de oleadas (dashboard/captacion)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cron oleadas: Authorization Bearer … o ?secret=
CRON_SECRET=

# Llamadas comerciales 15 min (calendario compartido NFCTap ↔ Delfín)
# Zoom/Meet permanente. Telegram ya usa TELEGRAM_* al reservar.
SALES_CALL_MEETING_URL=https://zoom.us/j/2139282300
# Secreto idéntico en NFCTap y Delfín (acepta también SALES_CALL_SYNC_SECRET)
CALLS_SYNC_SECRET=
# SALES_CALL_SYNC_SECRET=   # alias opcional del anterior
# URL del peer (Delfín) para espejar ocupados / reservas
SALES_CALL_PEER_URL=https://admin.delfincheckin.com

