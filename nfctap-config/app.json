{
  "expo": {
    "name": "NFC Tap Config",
    "slug": "nfctap-config",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nfctapconfig",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1c1915"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tech.nfctab.config",
      "infoPlist": {
        "NFCReaderUsageDescription": "NFCTap Config lee y escribe tus pegatinas NFC para reseñas, menús y enlaces.",
        "com.apple.developer.nfc.readersession.formats": ["TAG"]
      }
    },
    "android": {
      "package": "tech.nfctab.config",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1c1915"
      },
      "permissions": ["android.permission.NFC"]
    },
    "plugins": [
      "./plugins/with-quoted-constants-script",
      "expo-router",
      [
        "react-native-nfc-manager",
        {
          "includeNdefEntitlement": false,
          "nfcPermission": "NFCTap Config usa NFC para programar tus pegatinas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
